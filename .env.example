SMART_FARM_SECRET_KEY=replace-with-a-long-random-secret
SMART_FARM_DEBUG=1
SMART_FARM_HOST=0.0.0.0
# Use your PC/laptop LAN IP on a real phone; localhost works only on the same machine.
CAPACITOR_SERVER_URL=http://192.168.1.25:5000
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Set this as a private Railway variable for hosted Firebase Admin auth.
FIREBASE_ADMIN_CREDENTIALS_JSON=
# Keep the Firebase Admin service-account JSON private and outside source control.
GOOGLE_APPLICATION_CREDENTIALS=.local-dev/firebase-admin.json
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
AGMARKNET_API_KEY=
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
# Keep false in production; demo OTP is for controlled testing only.
KISAN_MANTRI_DEMO_AUTH=false
CROP_DIAGNOSIS_API_URL=
SATELLITE_NDVI_API_URL=
